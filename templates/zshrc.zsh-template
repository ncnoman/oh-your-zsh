# ==============================================================================
#  .zshrc - Powered by Oh Your Zsh (OYZ)
#  Fast, zero-dependency, zero-mystery shell configuration.
#  https://github.com/ncnoman/oh-your-zsh
# ==============================================================================

# Path to your Oh Your Zsh installation
export OYZ="$HOME/.oh-your-zsh"

# Prompt Style (Adaptive by default):
#   Unset/Auto : Automatically uses angled wedges (◥, ◣, ◣) in iTerm2, Ghostty,
#                WezTerm, and Kitty, and falls back to full-height solid ANSI
#                blocks in terminals where fonts leave gaps (Terminal.app, Zed, VS Code).
#   "wedges"   : Force angled text pointers everywhere.
#   "blocks"   : Force pure ANSI solid blocks everywhere.
# export OYZ_STYLE="wedges"

# Optional Theme: "default", "nord", "catppuccin", "monokai", "amber"
# export OYZ_THEME="default"

# Optional Custom Color Overrides (256-color palette)
# export OYZ_FG="0"
# export OYZ_BG_VENV="201"
# export OYZ_BG_DIR="33"
# export OYZ_BG_GIT_CLEAN="120"
# export OYZ_BG_GIT_DIRTY="208"

# Optional Plugins: add only what you need
# Built-ins: git, common-aliases
plugins=(git common-aliases)

# Load Oh Your Zsh
source "$OYZ/oh-your-zsh.zsh"

# ==============================================================================
#  User Configuration & Personal Aliases
# ==============================================================================

# export PATH="$HOME/.local/bin:$PATH"
# export EDITOR="vim"
